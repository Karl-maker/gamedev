{
  "name": "configurable-catalog-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:game": "node scripts/run-game-env.mjs dev",
    "build": "next build",
    "build:game": "node scripts/run-game-env.mjs build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "email:campaign": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/send-email-campaign.ts",
    "notion:setup": "node --env-file=.env.local scripts/setup-notion.mjs",
    "countries:generate": "node scripts/generate-country-data.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@notionhq/client": "^5.1.0",
    "@vercel/analytics": "^1.5.0",
    "csv-parse": "^7.0.3",
    "libphonenumber-js": "^1.13.17",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "nodemailer": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "simple-icons": "^16.38.0",
    "world-countries": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^25.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
